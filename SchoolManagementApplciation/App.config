<?xml version="1.0" encoding="utf-8"?>
<!--
  App.config for SchoolManagementApplciation (.NET 8 / net8.0-windows)
  Updated: Connection string converted from SQL Server to PostgreSQL 16 format.
  Use Microsoft.Extensions.Configuration for configuration in .NET 8.
-->
<configuration>
  <appSettings>
    <!-- PostgreSQL 16 connection string - update Host, Database, Username, Password as needed -->
    <add key="connectionString" value="Host=localhost;Port=5432;Database=School;Username=postgres;Password=admin123;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Timeout=30;"/>
  </appSettings>
</configuration>
